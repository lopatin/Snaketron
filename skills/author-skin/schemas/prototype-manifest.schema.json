{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snaketron.io/schemas/skin-factory/prototype-manifest-v1.json",
  "title": "Skin prototype manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief",
    "palette_intent",
    "motion_intent",
    "implementation_hint",
    "hint_rationale",
    "prompt",
    "model_config",
    "image_sha256"
  ],
  "properties": {
    "brief": { "type": "string", "minLength": 1 },
    "palette_intent": { "type": "string", "minLength": 1 },
    "motion_intent": { "type": "string", "minLength": 1 },
    "implementation_hint": {
      "enum": ["layers", "texture", "sprite_sheet", "hybrid"]
    },
    "hint_rationale": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1 },
    "model_config": { "type": "string", "minLength": 1 },
    "image_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
