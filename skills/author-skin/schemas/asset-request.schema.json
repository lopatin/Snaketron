{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snaketron.io/schemas/skin-factory/asset-request-v1.json",
  "title": "Pure task-worker asset request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "asset_index",
    "texture_name",
    "capability_role",
    "operation",
    "kind",
    "input_artifacts",
    "prompt",
    "width_px",
    "height_px",
    "grid",
    "required_wrap_axes",
    "transparency",
    "row_zero",
    "repair"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
    "asset_index": { "type": "integer", "minimum": 0 },
    "texture_name": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    },
    "capability_role": { "enum": ["image_generator", "image_editor"] },
    "operation": { "enum": ["generate", "edit"] },
    "kind": { "enum": ["coat", "sheet", "overlay"] },
    "input_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/contentHash" },
      "uniqueItems": true
    },
    "prompt": { "type": "string", "minLength": 1 },
    "width_px": { "type": "integer", "minimum": 1, "maximum": 2048 },
    "height_px": { "type": "integer", "minimum": 1, "maximum": 2048 },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body_columns", "frame_rows", "texels_per_cell"],
      "properties": {
        "body_columns": { "type": "integer", "minimum": 1, "maximum": 128 },
        "frame_rows": { "type": "integer", "minimum": 1, "maximum": 120 },
        "texels_per_cell": {
          "type": "integer",
          "minimum": 4,
          "maximum": 128
        }
      }
    },
    "required_wrap_axes": {
      "type": "array",
      "maxItems": 2,
      "items": { "enum": ["x", "y"] },
      "uniqueItems": true
    },
    "transparency": { "enum": ["opaque", "allowed", "required"] },
    "row_zero": {
      "enum": ["not_applicable", "resting_and_reduced_motion"]
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "mask_artifact"],
      "properties": {
        "method": { "enum": ["none", "tx_t_inpaint", "roll_and_repair"] },
        "mask_artifact": {
          "oneOf": [
            { "$ref": "#/$defs/contentHash" },
            { "type": "null" }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "generate" } } },
      "then": {
        "properties": {
          "capability_role": { "const": "image_generator" },
          "input_artifacts": { "maxItems": 0 },
          "repair": {
            "properties": {
              "method": { "const": "none" },
              "mask_artifact": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "operation": { "const": "edit" } } },
      "then": {
        "properties": {
          "capability_role": { "const": "image_editor" },
          "input_artifacts": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "sheet" } } },
      "then": {
        "properties": {
          "grid": {
            "properties": {
              "frame_rows": { "minimum": 2 },
              "texels_per_cell": { "const": 16 }
            }
          },
          "required_wrap_axes": { "contains": { "const": "y" } },
          "row_zero": { "const": "resting_and_reduced_motion" }
        }
      },
      "else": {
        "properties": {
          "grid": {
            "properties": {
              "frame_rows": { "const": 1 },
              "texels_per_cell": { "const": 64 }
            }
          },
          "row_zero": { "const": "not_applicable" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "repair": {
            "properties": {
              "method": { "enum": ["tx_t_inpaint", "roll_and_repair"] }
            },
            "required": ["method"]
          }
        }
      },
      "then": {
        "properties": {
          "repair": {
            "properties": {
              "mask_artifact": { "$ref": "#/$defs/contentHash" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
